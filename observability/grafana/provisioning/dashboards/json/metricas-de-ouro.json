{
  "uid": "caminho-livre-metricas-de-ouro",
  "title": "Caminho Livre - Métricas de Ouro",
  "description": "Latência, Tráfego, Erros e Saturação (Google SRE). Container local + sondas externas do Azure.",
  "tags": [
    "caminho-livre",
    "golden-signals",
    "sre"
  ],
  "timezone": "browser",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "ambiente",
        "label": "Ambiente",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-caminho-livre"
        },
        "query": {
          "query": "label_values(probe_success, ambiente)",
          "refId": "ambiente"
        },
        "definition": "label_values(probe_success, ambiente)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Latência",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tempo de resposta (sonda externa)",
      "description": "Tempo total da sonda HTTP do Blackbox Exporter. Alerta LatenciaAlta: média > 2 s por 5 min.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "probe_duration_seconds{job=\"blackbox-http\",ambiente=~\"$ambiente\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Fases da requisição (DNS, conexão, TLS, servidor, transferência)",
      "description": "Mostra onde o tempo é gasto: rede, TLS ou servidor.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "sum by (phase) (probe_http_duration_seconds{job=\"blackbox-http\",ambiente=~\"$ambiente\"})",
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Tráfego",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Requisições por segundo (nginx local)",
      "description": "Taxa de requisições do nginx do container (stub_status). O tráfego real do Azure está no Workbook do Azure Monitor (métrica Requests).",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "sum(rate(nginx_http_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "stat",
      "title": "Requisições na última hora",
      "description": "",
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "sum(increase(nginx_http_requests_total[1h]))",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "row",
      "title": "Erros e disponibilidade",
      "id": 7,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Disponibilidade agora",
      "description": "",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "probe_success{job=\"blackbox-http\",ambiente=~\"$ambiente\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA",
                  "color": "red"
                },
                "1": {
                  "text": "NO AR",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "type": "stat",
      "title": "Disponibilidade (24 h)",
      "description": "",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "avg_over_time(probe_success{job=\"blackbox-http\",ambiente=~\"$ambiente\"}[24h])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "stat",
      "title": "Alertas disparados",
      "description": "",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      }
    },
    {
      "type": "timeseries",
      "title": "Status HTTP das sondas",
      "description": "Alerta ErroHTTP5xx: status >= 500 por 1 min.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "probe_http_status_code{job=\"blackbox-http\",ambiente=~\"$ambiente\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 400
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "stat",
      "title": "Dias até o certificado TLS expirar",
      "description": "Preenchido para alvos HTTPS (Azure). Alerta CertificadoTLSExpirando: < 14 dias.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 27
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-http\"} - time()) / 86400",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "noValue": "Sem TLS (HTTP local)"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "type": "row",
      "title": "Saturação",
      "id": 13,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Conexões no nginx local",
      "description": "Alerta SaturacaoConexoesNginx: > 200 conexões ativas por 5 min. A CPU do App Service (CpuTime) está no Azure Monitor.",
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "nginx_connections_active",
          "legendFormat": "ativas"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "nginx_connections_reading",
          "legendFormat": "lendo"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "nginx_connections_writing",
          "legendFormat": "escrevendo"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "nginx_connections_waiting",
          "legendFormat": "ociosas (keep-alive)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "stat",
      "title": "Coletores de métricas",
      "description": "",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-caminho-livre"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-caminho-livre"
          },
          "expr": "up{job=~\"nginx|blackbox|prometheus\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FORA",
                  "color": "red"
                },
                "1": {
                  "text": "NO AR",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    }
  ]
}
