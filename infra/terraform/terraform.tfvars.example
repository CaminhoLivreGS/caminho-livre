# Copie para terraform.tfvars (ignorado pelo git) e preencha.
# Descubra a assinatura com: az account show --query id -o tsv

subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "eastus"

# Custo: F1 é gratuito. Troque para "B1" (~US$ 12,40/mês) só se o F1 não atender.
app_service_sku = "F1"

# Alertas de custo (USD/mês) e de operação (Métricas de Ouro) para estes e-mails.
orcamento_mensal_usd = 10
emails_alerta  = ["seu-email@exemplo.com"]

# Opcional: seu IP público para acessar o SCM/Kudu (SSH do App Service).
# Descubra com: curl -s https://api.ipify.org
# NUNCA use 0.0.0.0/0 (a validação rejeita).
admin_cidrs = []

# Identidades do GitHub criadas por infra/bootstrap/fundacao.sh
# (no CI vêm de vars.AZURE_*_PRINCIPAL_ID). Para aplicar localmente, use o seu
# object ID em github_apply_principal_id: az ad signed-in-user show --query id -o tsv
github_deploy_principal_id = "00000000-0000-0000-0000-000000000000"
github_plan_principal_id   = "00000000-0000-0000-0000-000000000000"
github_apply_principal_id  = "00000000-0000-0000-0000-000000000000"
